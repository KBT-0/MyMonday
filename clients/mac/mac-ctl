#!/bin/zsh
# mac-ctl: the only thing Monday's SSH key may run on this Mac (forced command, installed to ~/bin by
# clients/mac/install.sh). Opens the workstation's Claude leads in terminal windows (mosh + tmux view via `lead-attach`)
# and saves/restores the owner's iTerm2 window layout for "mode 2".
#   open [lead ...]   one window per given lead (default: first lead only)
#   save              record iTerm2 windows: bounds, tabs, split panes, which lead each pane shows
#   restore           reopen that layout (each pane reconnects to its lead)
#   layout            print the saved layout
#   idle              seconds since the owner last touched keyboard/mouse
#   list              leads registered on the workstation
#   check             what this Mac has (mosh, terminal app, reachability)
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
# WORKSTATION_HOST=<user>@<workstation tailnet IP> in ~/.config/monday-mac/mac.env (written by install.sh)
[ -r "$HOME/.config/monday-mac/mac.env" ] && . "$HOME/.config/monday-mac/mac.env"
# (a mac.env from before the rename has MONSTER_HOST: read for one release)
HOST="${WORKSTATION_HOST:-${MONSTER_HOST:-}}"
[ -n "$HOST" ] || { echo "set WORKSTATION_HOST=user@ip in ~/.config/monday-mac/mac.env" >&2; exit 2; }
LAYOUT="$HOME/.config/monday-mac/layout.tsv"
set -- ${=SSH_ORIGINAL_COMMAND:-$*}
verb="$1"; shift 2>/dev/null

leads() { ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" '~/bin/monday-leads list' 2>/dev/null | awk '{print $1}'; }
valid() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*$ ]]; }
lead_cmd() {
  if command -v mosh >/dev/null; then
    print -r -- "$(command -v mosh) --client=$(command -v mosh-client) $HOST -- lead-attach $1"
  else
    print -r -- "/usr/bin/ssh -t $HOST lead-attach $1"
  fi
}

open_one() {
  local name="$1" cmd
  valid "$name" || { echo "bad name: $name"; return 1; }
  cmd="$(lead_cmd "$name")"
  if [ -d /Applications/iTerm.app ]; then
    osascript -e "tell application \"iTerm\" to create window with default profile command \"$cmd\"" >/dev/null
  else
    osascript -e "tell application \"Terminal\" to do script \"$cmd\"" -e 'tell application "Terminal" to activate' >/dev/null
  fi && echo "opened $name"
}

# One TSV line per pane: window tab pane x1 y1 x2 y2 columns rows lead fullscreen
PROFILE_FS="Monday Lead Fullscreen"
ensure_fs_profile() {
  local dir="$HOME/Library/Application Support/iTerm2/DynamicProfiles" f parent
  f="$dir/monday-lead-fullscreen.json"
  grep -q '"Window Type":4' "$f" 2>/dev/null && return 0
  mkdir -p "$dir"
  parent="$(defaults read com.googlecode.iterm2 'Default Bookmark Guid' 2>/dev/null)"
  print -r -- '{"Profiles":[{"Name":"'"$PROFILE_FS"'","Guid":"monday-lead-fullscreen","Dynamic Profile Parent GUID":"'"$parent"'","Window Type":4}]}' > "$f"
  sleep 2   # iTerm2 picks up dynamic profiles on file change
}

save_layout() {
  [ -d /Applications/iTerm.app ] || { echo "save needs iTerm2"; return 1; }
  mkdir -p "${LAYOUT:h}"
  osascript > "$LAYOUT.tmp" <<'OSA' || { echo "could not read iTerm2 windows"; return 1; }
set out to ""
set TB to (ASCII character 9)
set LF to (ASCII character 10)
tell application "iTerm"
  set wi to 0
  repeat with w in windows
    set wi to wi + 1
    set b to bounds of w
    set ti to 0
    repeat with t in tabs of w
      set ti to ti + 1
      set si to 0
      repeat with s in sessions of t
        set si to si + 1
        set out to out & wi & TB & ti & TB & si & TB & (item 1 of b) & TB & (item 2 of b) & TB & (item 3 of b) & TB & (item 4 of b) & TB & (columns of s) & TB & (rows of s) & TB & (name of s) & LF
      end repeat
    end repeat
  end repeat
end tell
return out
OSA
  # keep only the lead name from pane titles like "[mosh] view-123-456:web"
  # column 11 = 1 when the window looks full screen (origin 0,0 or panes spanning >=180 columns)
  awk -F'\t' 'BEGIN{OFS="\t"} NF>=10 { n=$10; sub(/.*:/, "", n); sub(/[^A-Za-z0-9_-].*$/, "", n); $10=n;
       key=$1 FS $2; line[NR]=$0; k[NR]=key; w[key]+=$8; if ($4==0 && $5==0) z[$1]=1 }
       END { for (i=1;i<=NR;i++) if (i in line) { split(k[i],a,FS); print line[i], ((w[k[i]]>=180 || (a[1] in z)) ? 1 : 0) } }' "$LAYOUT.tmp" > "$LAYOUT"
  rm -f "$LAYOUT.tmp"
  echo "saved $(wc -l < "$LAYOUT" | tr -d ' ') panes to $LAYOUT"; cat "$LAYOUT"
}

win_ids() { osascript -e 'tell application "iTerm" to get id of every window' 2>/dev/null | tr -d ',' ; }

restore_layout() {
  [ -s "$LAYOUT" ] || { echo "no saved layout"; return 1; }
  local lastw="" lastt="" wid="" w t p x1 y1 x2 y2 cols rows lead fs cmd prof
  ensure_fs_profile
  : > "$LAYOUT.err"
  local known=" $(leads | tr '\n' ' ') "
  [ "$known" = "  " ] && { echo "workstation unreachable or no leads; not restoring"; return 1; }
  # windows that exist before we start (the owner's own); anything else we did not create is
  # iTerm's automatic default window (opened when the app is launched/activated) and gets closed
  local before="" made=" "
  pgrep -xq iTerm2 && before="$(win_ids)"
  while IFS=$'\t' read -r w t p x1 y1 x2 y2 cols rows lead fs; do
    valid "$lead" && [[ "$known" == *" $lead "* ]] || { echo "skip pane $w/$t/$p: not a lead (${lead:-?})"; continue; }
    # the layout file is data: numbers only before anything goes into AppleScript
    local v num=ok
    for v in "$w" "$t" "$p" "$x1" "$y1" "$x2" "$y2" "$cols" "$rows"; do [[ "$v" =~ ^-?[0-9]{1,6}$ ]] || num=bad; done
    [[ "$fs" =~ ^[01]$ ]] || num=bad
    [ "$num" = ok ] || { echo "skip pane: bad numbers in $LAYOUT"; continue; }
    cmd="$(lead_cmd "$lead")"
    if [ "$w" != "$lastw" ]; then
      # new window; remember its id so tabs/splits go into THIS window (focus may stay elsewhere)
      if [ "$fs" = 1 ]; then prof="profile \"$PROFILE_FS\""; else prof="default profile"; fi
      local -a bnd=()
      [ "$fs" = 1 ] || bnd=(-e "set bounds of nw to {$x1, $y1, $x2, $y2}")
      wid="$(osascript -e 'tell application "iTerm"' \
        -e "set nw to (create window with $prof command \"$cmd\")" \
        "${bnd[@]}" -e 'return id of nw' -e 'end tell' 2>>"$LAYOUT.err")"
      made="$made$wid "
      [ "$fs" = 1 ] && sleep 2   # let the full-screen animation finish before splitting
      lastw="$w"; lastt="$t"
    elif [ -z "$wid" ]; then
      echo "skip pane $w/$t/$p: window was not created"; continue
    elif [ "$t" != "$lastt" ]; then
      osascript -e "tell application \"iTerm\" to tell window id $wid to create tab with default profile command \"$cmd\"" >/dev/null 2>>"$LAYOUT.err"
      lastt="$t"
    else
      osascript -e "tell application \"iTerm\" to tell last session of current tab of window id $wid to split vertically with default profile command \"$cmd\"" >/dev/null 2>>"$LAYOUT.err"
    fi
    echo "pane $w/$t/$p -> $lead (window ${wid:-?})"; sleep 0.5
  done < "$LAYOUT"
  sleep 1
  local id
  for id in $(win_ids); do
    [[ " $before " == *" $id "* || "$made" == *" $id "* ]] && continue
    osascript -e "tell application \"iTerm\" to close window id $id" 2>>"$LAYOUT.err" && echo "closed stray default window $id"
  done
  [ -s "$LAYOUT.err" ] && { echo "--- osascript errors:"; cat "$LAYOUT.err"; }
  return 0
}

case "$verb" in
  open)
    names=("$@"); [ ${#names} -eq 0 ] && names=($(leads | head -1))
    [ ${#names} -eq 0 ] && { echo "no leads (workstation unreachable or registry empty)"; exit 1; }
    for n in $names; do open_one "$n"; sleep 0.5; done ;;
  save) save_layout ;;
  restore) restore_layout ;;
  layout) [ -s "$LAYOUT" ] && cat "$LAYOUT" || echo "no saved layout" ;;
  idle)   # seconds since the last keyboard/mouse/trackpad input on this Mac
    ioreg -c IOHIDSystem | awk '/HIDIdleTime/ { print int($NF/1000000000); exit }' ;;
  list) leads ;;
  check)
    echo "mosh: $(command -v mosh || echo missing)"
    [ -d /Applications/iTerm.app ] && echo "terminal: iTerm" || echo "terminal: Terminal.app"
    ssh -o BatchMode=yes -o ConnectTimeout=8 "$HOST" true 2>/dev/null && echo "workstation: reachable" || echo "workstation: NOT reachable"
    [ -s "$LAYOUT" ] && echo "layout: $(wc -l < "$LAYOUT" | tr -d ' ') panes saved" || echo "layout: none"
    f="$HOME/Library/Application Support/iTerm2/DynamicProfiles/monday-lead-fullscreen.json"
    [ -s "$f" ] && echo "fs-profile: $(cat "$f")" || echo "fs-profile: missing"
    echo "default-profile-guid: $(defaults read com.googlecode.iterm2 'Default Bookmark Guid' 2>&1)"
    ls "$HOME/Library/Application Support/iTerm2/DynamicProfiles/" 2>&1 | sed 's/^/dyn: /' ;;
  *) echo "usage: open [lead...] | save | restore | layout | idle | list | check"; exit 2 ;;
esac
