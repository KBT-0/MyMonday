#!/usr/bin/env bash
# monster-ctl: what Monday runs on Monster (forced command for Monday's SSH key).
# Claude Code sessions live in the tmux server "monster", so the owner can attach to the
# same sessions with `mon`.
#
#   status                  uptime, battery, load, sessions
#   projects                folders in the owner's ~/projects
#   ls                      tmux sessions
#   start <name> [dir]      new session running claude (dir: project folder name or path)
#   read <name> [lines]     last screen lines of a session (default 60)
#   send <name>             type stdin into the session, then Enter
#   key <name> <key...>     send tmux keys, e.g. Escape, C-c, Enter
#   stop <name>             end the session
#   off | reboot            power off / reboot Monster
set -euo pipefail

DEV=${MONSTER_DEV:-$HOME/projects}
CLAUDE=${MONSTER_CLAUDE:-$HOME/.local/bin/claude}
t() { tmux -L monster "$@"; }
name_ok() { [[ "$1" =~ ^[A-Za-z0-9_-]{1,32}$ ]] || { echo "bad session name: $1" >&2; exit 2; }; }

# --ssh: called by sshd; the words of the client's command become the arguments
if [ "${1:-}" = --ssh ]; then read -ra a <<< "${SSH_ORIGINAL_COMMAND:-status}"; exec "$0" "${a[@]}"; fi
cmd=${1:-status}; shift || true
case "$cmd" in
  status)
    uptime -p; cat /sys/class/power_supply/BAT0/capacity /sys/class/power_supply/AC0/online 2>/dev/null \
      | paste -sd' ' | awk '{print "battery " $1 "%, on AC: " ($2==1?"yes":"no")}'
    cut -d' ' -f1-3 /proc/loadavg
    # the owner's own desktop login (open windows, maybe work resumed from sleep)
    for s in $(loginctl list-sessions --no-legend | awk -v u="$USER" '$3==u {print $1}'); do
      [ "$(loginctl show-session "$s" -p Type --value)" = wayland ] && echo "DESKTOP: the owner is logged in (open work)"
    done
    t ls 2>/dev/null || echo "no sessions" ;;
  projects) ls -1 "$DEV" ;;
  ls) t ls 2>/dev/null || echo "no sessions" ;;
  start)
    name_ok "${1:?name}"; d=${2:-$1}; [[ "$d" = /* ]] || d="$DEV/$d"
    [ -d "$d" ] || { echo "no such folder: $d" >&2; exit 2; }
    t has-session -t "=$1" 2>/dev/null && { echo "session $1 already running"; exit 0; }
    # a normal login shell (PATH, fnm, cswap as in a terminal), then claude in it; the shell
    # stays when claude exits, so the owner can keep working there with `mon`
    t new-session -d -s "$1" -c "$d" -x 220 -y 50
    sleep 1; t send-keys -t "=$1:" -l -- "$CLAUDE"; t send-keys -t "=$1:" Enter
    echo "started $1 in $d" ;;
  read) name_ok "${1:?name}"; t capture-pane -p -J -t "=$1:" -S "-${2:-60}" ;;
  send)
    name_ok "${1:?name}"; text=$(cat); [ -n "$text" ] || { echo "nothing on stdin" >&2; exit 2; }
    t send-keys -t "=$1:" -l -- "$text"; sleep 0.3; t send-keys -t "=$1:" Enter; echo sent ;;
  key) name_ok "${1:?name}"; s=$1; shift; t send-keys -t "=$s:" "$@"; echo sent ;;
  stop) name_ok "${1:?name}"; t kill-session -t "=$1"; echo "stopped $1" ;;
  off) t kill-server 2>/dev/null || true; sudo -n /usr/bin/systemctl poweroff ;;
  reboot) sudo -n /usr/bin/systemctl reboot ;;
  *) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
