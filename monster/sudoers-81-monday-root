# /etc/sudoers.d/81-monday-root (root:root 440): Monday's allow-listed root actions.
# sudo (>= 1.9.10, Monster has 1.9.17) allows exactly one command word and one name matching
# monday-root's own regex; monday-root then also checks the name against /etc/monday-root/.
# Looser wildcard form (the trailing * matches anything, spaces and options included):
#   OWNER ALL=(root) NOPASSWD: /usr/local/sbin/monday-root pkg-install *, /usr/local/sbin/monday-root service-restart *
# OWNER is replaced with the workstation owner by install-root.sh. secure_path: monday-root runs with a
# fixed PATH whatever the caller's environment (the script sets the same PATH itself).
Defaults!/usr/local/sbin/monday-root secure_path="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
OWNER ALL=(root) NOPASSWD: /usr/local/sbin/monday-root ^(pkg-install|service-restart) [a-z0-9][a-z0-9@._+-]*$
