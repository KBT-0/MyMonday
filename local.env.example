# local.env: every personal value of a MyMonday install, in one file next to README.md.
# Copy to local.env (git-ignored) and fill it in:  cp local.env.example local.env && chmod 600 local.env
# Plain KEY=VALUE lines (bash syntax, sourced): no spaces around "=", double-quote values with spaces. It holds addresses and ids, never
# secrets: API keys and bot tokens are typed into Hermes's/CCGram's own config files (README).
# Who reads it: server/bootstrap.sh (all phases), the server/ops jobs (copied to OPS_DIR by the ops
# phase), workstation/setup.sh + install-user.sh (copied to ~/.config/monday/workstation.env on the workstation).
# Empty value = feature off or built-in default.

# ---- you --------------------------------------------------------------------------------------
# How the assistant names you (SOUL.md, the workstation skill, prompts).
OWNER_NAME=
# Language the assistant answers in, and of the nightly memory report. Example: English
ASSISTANT_LANGUAGE=English
# Language of the server/ops notification texts: en | tr
OPS_LANG=en
# Welcome line of the Hermes CLI skin (persona phase). Empty: "Monday is ready."
ASSISTANT_WELCOME=
# Your numeric Telegram user id: the CCGram allowlist on the workstation (Hermes keeps its own).
TELEGRAM_USER_ID=

# ---- server (the always-on VPS) ---------------------------------------------------------------
SERVER_HOSTNAME=monday
# IANA zone, e.g. Europe/Berlin (default UTC)
SERVER_TIMEZONE=
# The server's Tailscale IPv4 (100.x.y.z): the workstation accepts the assistant's key only from it.
SERVER_IP=
# Runtime home of the server/ops jobs (scripts, state/, local.env copy). Default /srv/projects/monday-ops
OPS_DIR=
# The memory vault (brain-core, brain-private, brain-sensitive, brain-raw). Default /srv/projects/brain
BRAIN_DIR=

# ---- workstation (the main work PC; Linux, at home) -------------------------------------------
# Tailscale IPv4 and login user of the workstation.
WORKSTATION_HOST=
WORKSTATION_USER=
# ssh alias the assistant uses for it (~/.ssh/config block of the workstation phase, the ops jobs, the
# skill); the waker phones become <alias>-phone1/2. Empty: workstation.
WORKSTATION_SSH_ALIAS=
# Projects root on the workstation, relative to WORKSTATION_USER's home (leads, Telegram-started sessions).
WORKSTATION_PROJECTS=projects
# Tailscale IPv4 of the Wake-on-LAN phone(s) on the workstation's LAN (Termux sshd :8022). Both optional:
# without one, workstation-wake cannot wake the workstation (it must then be started by hand).
WORKSTATION_PHONE1=
WORKSTATION_PHONE2=
# Agent kit used by the projects (a Claude Code plugin that keeps lead state in files), see docs/leads.md:
# its per-project folder and its slash-command namespace. Leave as is if you use none.
LEADS_KIT_DIR=.agentkit
LEADS_KIT_CMD=/agentkit
# Language of the workstation's desktop popups from the Claude Code hook: en | tr
NOTIFY_LANG=en
# Claude Code version pinned for leads only (e.g. 2.1.300, a folder in ~/.local/share/claude/versions).
# Empty: no pin, leads run the current claude and it updates itself as usual.
LEAD_CLAUDE_VERSION=
# CCGram (Telegram topic per lead) on the workstation: yes | no
WORKSTATION_CCGRAM=yes
# tmux server (-L) of the leads on the workstation. Empty: leads.
LEADS_SOCKET=

# ---- Mac (optional client, "mode 2") -----------------------------------------------------------
# Tailscale IPv4 and user of the Mac, for `ssh mac` (mac-ctl). Empty: no Mac alias.
MAC_HOST=
MAC_USER=
# Tailscale host name prefix of the Mac (lead_watch leaves mode 2 when it goes offline), lowercase.
MAC_HOSTNAME_PREFIX=macbook

# ---- daily spend summary (optional) ------------------------------------------------------------
# API balance in USD at SPEND_BASE_TIME (ISO 8601 with offset); the summary then shows the estimated
# remaining balance. Empty: no balance line, counting starts at the first run.
SPEND_BASE_BALANCE=
SPEND_BASE_TIME=

# Claude accounts on the workstation (claude-swap, optional): server/ops/account_watch.py switches to the
# next ACCOUNTS_AUTO account with quota left when the active one nears its limit (at a turn boundary
# when it can). ACCOUNTS_ASK accounts (e.g. company seats) are never switched to automatically: the owner
# is asked. Numbers are claude-swap's account numbers, quoted when several: ACCOUNTS_AUTO="1 2". Empty: off.
ACCOUNTS_AUTO=
ACCOUNTS_ASK=
ACCOUNT_5H_MAX=95
ACCOUNT_7D_MAX=97
