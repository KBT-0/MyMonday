#!/usr/bin/env bash
# workstation-wake: ask a phone on the workstation's home LAN to send the Wake-on-LAN packet.
# Each phone's key entry is a forced command (wol.py), so the SSH call needs no command.
# Phones are tried in order; ssh aliases come from the workstation phase (~/.ssh/config), which
# installs this script with WAKERS_DEFAULT set to <WORKSTATION_SSH_ALIAS>-phone1/2.
WAKERS_DEFAULT="workstation-phone1 workstation-phone2"
for h in ${WORKSTATION_WAKERS:-$WAKERS_DEFAULT}; do
  ssh -o BatchMode=yes "$h" 2>/dev/null | grep -q "wake sent" && { echo "wake sent via $h"; exit 0; }
done
echo "no waker reachable" >&2; exit 1
