[Unit]
Description=Hermes WebUI (loopback only, 127.0.0.1:8787; tailnet via tailscale serve :443)
ConditionUser=monday
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/hermes-webui
# Login settings, written by hand (see server/README.md); never in the repo.
EnvironmentFile=%h/.config/hermes-webui/env
ExecStart=/usr/bin/python3 %h/apps/hermes-webui/bootstrap.py --foreground --no-browser --skip-agent-install --host 127.0.0.1 8787
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
