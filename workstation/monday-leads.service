# systemd user unit: start the project leads at boot (installed to ~/.config/systemd/user, not enabled).
# Without a desktop login it needs lingering: sudo loginctl enable-linger <owner>
[Unit]
Description=Monday project leads (tmux -L leads, session leads)
# a user manager has no network-online.target of its own: best effort ordering only
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=%h/bin/monday-leads up
# the tmux server forked by `up` lives in this unit's cgroup: stopping the unit must not kill the leads
KillMode=process
TimeoutStartSec=15min

[Install]
WantedBy=default.target
