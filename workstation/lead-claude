#!/usr/bin/env bash
# lead-claude: the claude CCGram starts for a session opened from Telegram (CCGRAM_CLAUDE_COMMAND in
# ~/.config/monday/ccgram.env; installed to ~/bin). Refuses a folder outside WORKSTATION_DEV (the projects root) and any
# skip-permissions flag. A project without a lead becomes one: the window is renamed to the lead name
# (folder name, -2, -3... when taken; the Telegram topic keeps its title) and registered with
# `monday-leads add`, so Monday sees it; claude runs as `-n <lead>` like a lead started by monday-leads.
# CCGram closes a window it created once its claude exits (park included): `monday-leads up NAME` opens a new one.
set -uo pipefail
# personal values (WORKSTATION_DEV, LEADS_KIT_*, LEADS_SOCKET): ~/.config/monday/workstation.env, written
# by install-user.sh from the repo's local.env; variables already in the environment win.
wenv=$HOME/.config/monday/workstation.env
while IFS='=' read -r k v; do [ -n "${!k+x}" ] || export "$k=$v"; done \
  < <(grep -E '^[A-Z_][A-Z0-9_]*=' "$wenv" 2>/dev/null)
dev=$(readlink -f "${WORKSTATION_DEV:-$HOME/projects}")
here=$(pwd -P)
case "$here/" in "$dev"/?*/) ;; *) echo "lead-claude: refused, $here is not under $dev" >&2; exit 2 ;; esac
for a in "$@"; do
  case "$a" in *dangerously*|*bypassPermissions*) echo "lead-claude: refused, no $a" >&2; exit 2 ;; esac
done
leads=$HOME/bin/monday-leads reg=$HOME/.config/monday/leads.json
name=""
# a lead already runs this folder (or a parked one owns it): no second registration, just claude
if ! jq -e --arg d "$here" 'any(.[]; .dir == $d or .worktree == $d)' "$reg" >/dev/null 2>&1; then
  base=$(basename "$here" | tr -c 'A-Za-z0-9_-' '-' | cut -c1-28); base=${base%-}
  name=$base; i=2
  while jq -e --arg n "$name" 'has($n)' "$reg" >/dev/null 2>&1; do name=$base-$i; i=$((i + 1)); done
  if "$leads" add "$name" "$here" >/dev/null; then
    tmux rename-window -t "${TMUX_PANE:?}" "$name"
  else
    name=""
  fi
fi
# shellcheck source=/dev/null
[ -r "$HOME/.config/monday/lead-env" ] && . "$HOME/.config/monday/lead-env"
bin=${LEAD_CLAUDE:-$HOME/.local/bin/claude}
exec -a claude "$bin" ${name:+-n "$name"} "$@"
